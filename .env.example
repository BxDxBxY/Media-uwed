# =============================================================================
# Media-uwed — environment configuration
#
# Copy to `.env` and fill in. Generate every secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real `.env` (it is gitignored).
# =============================================================================

# --- Required ----------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_uwed?schema=public"

# Signs admin session cookies. Rotating it signs everyone out.
# Falls back to NEXTAUTH_SECRET, then to a hardcoded dev value — never rely on that
# in production.
ADMIN_SESSION_SECRET=""

# Encrypts integration secrets (AI provider key, Telegram bot token) at rest.
# WARNING: change this and previously stored secrets can no longer be decrypted;
# they must be re-entered in Admin → Automation → Integrations.
ADMIN_SECRET_ENCRYPTION_KEY=""

# Public origin of the site. Used for canonical URLs, Open Graph tags, the sitemap,
# password-reset links and Telegram post links. Without it those fall back to
# http://localhost:3000, which breaks SEO and emails in production.
APP_URL="https://media.example.uz"

# --- Automation --------------------------------------------------------------

# Shared secret for the scheduler that calls POST /api/cron/automation.
# If unset, scheduler access is DISABLED (fails closed) and only a signed-in admin
# can trigger the pipeline manually.
#   curl -X POST https://<host>/api/cron/automation -H "x-automation-secret: <value>"
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`, which is also accepted.
AUTOMATION_CRON_SECRET=""

# --- AI provider (optional, but the pipeline is much weaker without it) -------

# Fallback provider key used when no key is stored in the admin Integrations panel.
# Prefer storing the key in the admin UI (encrypted at rest) over this variable.
OPENROUTER_API_KEY=""

# Model used for the editorial pass (rewrite + summarise + translate + categorise).
OPENROUTER_TRANSLATE_MODEL="openai/gpt-4o-mini"
# Model used by the admin assistant chat.
OPENROUTER_ASSISTANT_MODEL="openai/gpt-4o-mini"

# Sent as HTTP-Referer / X-Title to OpenRouter for attribution.
OPENROUTER_REFERER=""
OPENROUTER_TITLE="University Media AI"

# --- Email (optional; required for password-reset emails and broadcasts) ------

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Media Uwed <noreply@example.uz>"

# --- Admin bootstrap ---------------------------------------------------------

# Used by `npm run admin:create`, which upserts a super admin by email.
# ADMIN_PASSWORD must be at least 8 characters or the script exits with an error.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@university.edu"
ADMIN_PASSWORD=""

# Set to "false" to close public self-registration at /admin/signup once the
# editorial team has their accounts. New accounts always require super-admin
# approval regardless of this setting.
ADMIN_SIGNUP_ENABLED="true"

# --- Legacy ------------------------------------------------------------------

# NextAuth is not used (auth is custom, see lib/admin-auth.ts). NEXTAUTH_SECRET is
# only read as a fallback for the two secrets above; set those explicitly instead.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
