generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Article {
  id             String        @id @default(uuid())
  title          String
  titleRu        String?
  titleUz        String?
  summary        String
  summaryRu      String?
  summaryUz      String?
  content        String
  contentRu      String?
  contentUz      String?
  image          String
  imageCaption   String?
  imageCaptionRu String?
  imageCaptionUz String?
  date           String
  slug           String        @unique
  author         String
  url            String?
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  viewRecords    ArticleView[]
  categories     Category[]    @relation("ArticleToCategory")

  @@index([createdAt])
  @@map("articles")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  articles Article[] @relation("ArticleToCategory")

  @@map("categories")
}

model AboutContent {
  id        String   @id @default(uuid())
  title     String
  titleRu   String?
  titleUz   String?
  content   String
  contentRu String?
  contentUz String?
  image     String?
  updatedAt DateTime @updatedAt

  @@map("about_content")
}

model SiteVisit {
  id                String   @id @default(uuid())
  timestamp         DateTime @default(now())
  visitorIdentifier String

  @@index([timestamp])
  @@map("site_visits")
}

model ArticleView {
  id                String   @id @default(uuid())
  articleId         String
  timestamp         DateTime @default(now())
  visitorIdentifier String
  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([timestamp])
  @@map("article_views")
}

model Event {
  id            String   @id @default(uuid())
  title         String
  titleRu       String?
  titleUz       String?
  description   String?
  descriptionRu String?
  descriptionUz String?
  date          String
  time          String
  location      String
  locationRu    String?
  locationUz    String?
  attendees     Int?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@map("events")
}

model Media {
  id        String   @id @default(uuid())
  type      String
  title     String
  titleRu   String?
  titleUz   String?
  url       String
  thumbnail String?
  duration  String?
  count     String?
  category  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("subscribers")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  readAt    DateTime?
  archivedAt DateTime?
  createdAt DateTime @default(now())

  @@index([archivedAt, createdAt])
  @@index([subject])
  @@map("contact_messages")
}

model SiteSettings {
  id                  String   @id @default("default")
  siteName            String   @default("University Media Portal")
  contactEmail        String   @default("admin@university.edu")
  siteDescription     String   @default("The official news and media portal for University students and faculty.")
  metaTitle           String   @default("University Media | Latest News & Events")
  keywords            String   @default("university, news, events, campus life, research, education")
  defaultLanguage     String   @default("en")
  enableNotifications Boolean  @default(true)
  enableComments      Boolean  @default(true)
  moderateComments    Boolean  @default(true)
  themeMode           String   @default("system")
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}

model Source {
  id            String       @id @default(uuid())
  name          String
  feedUrl       String       @unique
  category      String?
  enabled       Boolean      @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime     @default(now())
  articles      ArticleRaw[]

  @@index([enabled, createdAt])
  @@index([enabled, lastFetchedAt])
  @@map("sources")
}

model ArticleRaw {
  id          String            @id @default(uuid())
  sourceId    String
  guid        String
  url         String            @unique
  title       String
  description String?
  author      String?
  imageUrl    String?
  publishedAt DateTime?
  rawJson     String?
  createdAt   DateTime          @default(now())
  /// Topical triage against the admin's editorial brief: "relevant" | "rejected".
  /// Null means not yet judged. Stored so a rejected item is not re-judged on every run —
  /// re-judging would spend the free tier's daily request budget on the same headlines.
  relevance         String?
  relevanceReason   String?
  relevanceCheckedAt DateTime?
  processed   ArticleProcessed?
  source      Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, guid])
  @@index([relevance, createdAt])
  @@map("articles_raw")
}

model ArticleProcessed {
  id         String     @id @default(uuid())
  rawId      String     @unique
  headlineEn String
  headlineRu String?
  headlineUz String?
  summaryEn  String
  summaryRu  String?
  summaryUz  String?
  contentEn  String?
  contentRu  String?
  contentUz  String?
  categories String?
  status     String     @default("pending_review")
  createdAt  DateTime   @default(now())
  raw        ArticleRaw @relation(fields: [rawId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("articles_processed")
}




model AutomationConfig {
  id              String   @id @default("default")
  includeKeywords String?
  excludeKeywords String?
  aiInstructions  String?
  aiStrictMode    Boolean  @default(false)
  automatedPull   Boolean  @default(true)
  processing      Boolean  @default(true)
  translation      Boolean  @default(true)
  fetchPeriodMinutes  Int      @default(30)
  lastScheduledRunAt DateTime?
  updatedAt         DateTime @updatedAt

  @@map("automation_configs")
}

model AdminApiKey {
  id          String    @id @default(uuid())
  name        String
  keyPrefix   String
  keyHash     String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("admin_api_keys")
}

model AdminUser {
  id                String        @id @default(uuid())
  username          String        @unique
  email             String        @unique
  passwordHash      String
  role              String        @default("admin")
  approved          Boolean       @default(false)
  resetToken        String?       @unique
  resetTokenExpires DateTime?
  isSuperAdmin      Boolean       @default(false)
  /// Sessions issued before this moment are refused when entering the admin UI.
  passwordChangedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  apiKeys           AdminApiKey[]

  @@map("admin_users")
}

/// Admin assistant chat memory and pending confirmation tokens.
/// Previously these rows lived in `contact_messages` behind magic subject values,
/// which mixed internal state into the public inbox.
model AssistantMemory {
  id         String    @id @default(uuid())
  kind       String // "message" | "action"
  role       String? // "user" | "assistant" (kind = "message")
  content    String
  token      String?   @unique // kind = "action"
  actionType String? // "publish" | "delete"
  target     String?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
  @@map("assistant_memory")
}

/// Editable page configuration that is a document rather than a set of columns —
/// currently the About page (mission, team, contact block).
///
/// It used to live in `contact_messages` under the magic subject `__about_page_config__`,
/// with every save inserting a **new** row, so internal configuration accumulated inside
/// the public contact inbox forever. Same reasoning as moving assistant memory out of that
/// table in the 2026-07-31 hardening pass.
model PageConfig {
  key       String   @id // e.g. "about"
  value     String // JSON document
  updatedAt DateTime @updatedAt

  @@map("page_configs")
}

/// Requests sent to the AI provider per UTC day.
///
/// Exists because the deployment runs on OpenRouter's free tier: 50 requests/day shared
/// across every `:free` model. Without a counter the first cron run of the day would
/// spend the whole quota on one batch and every later article would silently degrade to
/// the heuristic pipeline. One row per day; old rows are harmless history.
model AiUsageDay {
  day       String   @id // UTC calendar day, "YYYY-MM-DD"
  requests  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("ai_usage_days")
}

model IntegrationConfig {
  id                      String   @id @default(uuid())
  integrationType         String   @unique
  enabled                 Boolean  @default(false)
  provider                String?
  providerModel           String?
  providerApiKeyEncrypted String?
  providerApiKeyHash      String?
  providerBaseUrl         String?  @default("https://openrouter.ai/api/v1")
  channelId               String?
  webhookTokenEncrypted   String?
  sendOnPublish           Boolean  @default(false)
  aiSummarization         Boolean  @default(true)
  aiCategorization        Boolean  @default(true)
  translationPolicy       String   @default("full")
  editorialPrompt         String?
  retryLimit              Int      @default(3)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("integration_configs")
}
