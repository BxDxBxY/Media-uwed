generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Article {
  id             String        @id @default(uuid())
  title          String
  titleRu        String?
  titleUz        String?
  summary        String
  summaryRu      String?
  summaryUz      String?
  content        String
  contentRu      String?
  contentUz      String?
  image          String
  imageCaption   String?
  imageCaptionRu String?
  imageCaptionUz String?
  date           String
  slug           String        @unique
  author         String
  url            String?
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  viewRecords    ArticleView[]
  categories     Category[]    @relation("ArticleToCategory")

  @@map("articles")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  articles Article[] @relation("ArticleToCategory")

  @@map("categories")
}

model AboutContent {
  id        String   @id @default(uuid())
  title     String
  titleRu   String?
  titleUz   String?
  content   String
  contentRu String?
  contentUz String?
  image     String?
  updatedAt DateTime @updatedAt

  @@map("about_content")
}

model SiteVisit {
  id                String   @id @default(uuid())
  timestamp         DateTime @default(now())
  visitorIdentifier String

  @@map("site_visits")
}

model ArticleView {
  id                String   @id @default(uuid())
  articleId         String
  timestamp         DateTime @default(now())
  visitorIdentifier String
  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_views")
}

model Event {
  id            String   @id @default(uuid())
  title         String
  titleRu       String?
  titleUz       String?
  description   String?
  descriptionRu String?
  descriptionUz String?
  date          String
  time          String
  startsAt      DateTime?
  endsAt        DateTime?
  location      String
  locationRu    String?
  locationUz    String?
  attendees     Int?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("events")
}

model Media {
  id        String   @id @default(uuid())
  type      String
  title     String
  titleRu   String?
  titleUz   String?
  url       String
  thumbnail String?
  duration  String?
  count     String?
  category  String?
  createdAt DateTime @default(now())

  @@map("media")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  readAt    DateTime?
  archivedAt DateTime?
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model SiteSettings {
  id                  String   @id @default("default")
  siteName            String   @default("University Media Portal")
  contactEmail        String   @default("admin@university.edu")
  siteDescription     String   @default("The official news and media portal for University students and faculty.")
  metaTitle           String   @default("University Media | Latest News & Events")
  keywords            String   @default("university, news, events, campus life, research, education")
  defaultLanguage     String   @default("en")
  enableNotifications Boolean  @default(true)
  enableComments      Boolean  @default(true)
  moderateComments    Boolean  @default(true)
  themeMode           String   @default("system")
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}

model Source {
  id            String       @id @default(uuid())
  name          String
  feedUrl       String       @unique
  category      String?
  enabled       Boolean      @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime     @default(now())
  articles      ArticleRaw[]

  @@map("sources")
}

model ArticleRaw {
  id          String            @id @default(uuid())
  sourceId    String
  guid        String
  url         String            @unique
  title       String
  description String?
  author      String?
  imageUrl    String?
  publishedAt DateTime?
  rawJson     String?
  createdAt   DateTime          @default(now())
  processed   ArticleProcessed?
  source      Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, guid])
  @@map("articles_raw")
}

model ArticleProcessed {
  id         String     @id @default(uuid())
  rawId      String     @unique
  headlineEn String
  headlineRu String?
  headlineUz String?
  summaryEn  String
  summaryRu  String?
  summaryUz  String?
  contentEn  String?
  contentRu  String?
  contentUz  String?
  categories String?
  status     String     @default("pending_review")
  createdAt  DateTime   @default(now())
  raw        ArticleRaw @relation(fields: [rawId], references: [id], onDelete: Cascade)

  @@map("articles_processed")
}



model AdminApiKey {
  id          String    @id @default(uuid())
  name        String
  keyPrefix   String
  keyHash     String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("admin_api_keys")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime      @updatedAt
  apiKeys      AdminApiKey[]

  @@map("admin_users")
}
